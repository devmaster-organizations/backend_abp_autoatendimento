generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SECRETARIA

  @@map("user_role")
}

enum InquiryStatus {
  ABERTA
  RESPONDIDA

  @@map("inquiry_status")
}

enum SatisfactionFlag {
  ATENDEU
  NAO_ATENDEU

  @@map("satisfaction_flag")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(120)
  email             String    @unique @db.VarChar(160)
  passwordHash      String    @map("password_hash")
  role              UserRole
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  answeredInquiries Inquiry[]

  @@map("users")
}

model NavigationNode {
  id              BigInt           @id @default(autoincrement()) @db.BigInt
  parentId        BigInt?          @map("parent_id") @db.BigInt
  title           String           @db.VarChar(180)
  slug            String           @unique @db.VarChar(180)
  prompt          String?          @db.VarChar(1000)
  answerSummary   String?          @map("answer_summary")
  evidenceExcerpt String?          @map("evidence_excerpt")
  evidenceSource  String?          @map("evidence_source") @db.VarChar(500)
  displayOrder    Int              @default(0) @map("display_order")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent          NavigationNode?  @relation("NavigationNodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        NavigationNode[] @relation("NavigationNodeHierarchy")

  @@index([parentId], map: "idx_navigation_nodes_parent_id")
  @@map("navigation_nodes")
}

model ChatFlowNode {
  id            String           @id @db.VarChar(120)
  botMessage    String           @map("bot_message")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  options       ChatFlowOption[] @relation("ChatFlowOptionsFromNode")
  incomingLinks ChatFlowOption[] @relation("ChatFlowOptionsToNode")

  @@map("chat_flow_nodes")
}

model ChatFlowOption {
  id           BigInt       @id @default(autoincrement()) @db.BigInt
  label        String       @db.VarChar(180)
  fromNodeId   String       @map("from_node_id") @db.VarChar(120)
  toNodeId     String       @map("to_node_id") @db.VarChar(120)
  displayOrder Int          @default(0) @map("display_order")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  fromNode     ChatFlowNode @relation("ChatFlowOptionsFromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       ChatFlowNode @relation("ChatFlowOptionsToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([fromNodeId], map: "idx_chat_flow_options_from_node_id")
  @@index([toNodeId], map: "idx_chat_flow_options_to_node_id")
  @@unique([fromNodeId, displayOrder], map: "uq_chat_flow_options_from_order")
  @@map("chat_flow_options")
}

model Inquiry {
  id                 BigInt         @id @default(autoincrement()) @db.BigInt
  requesterName      String         @map("requester_name") @db.VarChar(160)
  requesterEmail     String         @map("requester_email") @db.VarChar(160)
  question           String
  attachmentName     String?        @map("attachment_name") @db.VarChar(255)
  attachmentMimeType String?        @map("attachment_mime_type") @db.VarChar(100)
  attachmentData     Bytes?         @map("attachment_data")
  status             InquiryStatus  @default(ABERTA)
  answeredById       String?        @map("answered_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  answeredBy         User?          @relation(fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([status], map: "idx_inquiries_status")
  @@map("inquiries")
}

model InteractionLog {
  id             BigInt            @id @default(autoincrement()) @db.BigInt
  sessionId      String            @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  navigationFlow Json              @default("[]") @map("navigation_flow") @db.JsonB
  inquiryIds     Json              @default("[]") @map("inquiry_ids") @db.JsonB
  flag           SatisfactionFlag?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sessionId], map: "idx_interaction_logs_session_id")
  @@map("interaction_logs")
}
